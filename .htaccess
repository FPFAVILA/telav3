RewriteEngine On

# Block direct access to sensitive files
RewriteRule \.(json|md|env|lock)$ - [F]
RewriteRule ^(db_config|redirect_stub|gerar_hash|composer)\.php$ - [F]

# Redireciona todas as requisições que não são para um arquivo ou pasta existente
# para o seu script principal (se você usar um roteador) ou apenas normaliza
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# Garante que o cabeçalho de autorização (se usado no futuro) seja passado
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
